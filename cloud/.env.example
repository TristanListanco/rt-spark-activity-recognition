# Copy to cloud/.env and change the passwords. Never commit .env.

# MQTT account used by the board, the classifier and tools/
MQTT_USERNAME=device
MQTT_PASSWORD=change-me

# PostgreSQL
POSTGRES_DB=activity
POSTGRES_USER=activity
POSTGRES_PASSWORD=change-me

# Port the Flask API is published on (80 on the Azure VM)
API_PORT=5000
