# Copy to cloud/.env and change the passwords. Never commit .env.

# MQTT account used by the board, the classifier and tools/
MQTT_USERNAME=device
MQTT_PASSWORD=change-me
MQTT_PORT=1883

# PostgreSQL
POSTGRES_DB=activity
POSTGRES_USER=activity
POSTGRES_PASSWORD=change-me

# Port the Flask API is published on. 8000 locally (macOS uses 5000 for
# AirPlay); 80 on the Azure VM.
API_PORT=8000

# Time zone used to decide which calendar day /api/summary counts
APP_TIMEZONE=Asia/Manila
